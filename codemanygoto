    add_block('simulink/Signal Routing/Goto', ['Arras700mw_1/', goto_tag_name], 'GotoTag', goto_tag_name, 'TagVisibility', 'global', 'Position', [x_goto, y_goto, x_goto+30, y_goto+14]);
   
